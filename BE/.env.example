# ============================================================================
# TELOS BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update values for your environment

# SERVER CONFIGURATION
# ============================================================================
PORT=5000
NODE_ENV=development

# SESSION CONFIGURATION
# ============================================================================
# IMPORTANT: Use a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_secure_random_string_here_change_in_production

# ONE-TIME OWNER BOOTSTRAP
# Set a strong random secret before the first owner is created.
# Remove/unset it after POST /api/auth/bootstrap-owner succeeds.
OWNER_SETUP_SECRET=

# USER CONTRACT STORAGE
# Store private contract PDFs outside the public web root on durable storage.
CONTRACT_STORAGE_DIR=

# EMAIL VERIFICATION (Resend free tier: 3,000 emails/month, 100/day)
# Create a free API key at https://resend.com and verify your sending domain
# (SPF/DKIM DNS records). Without RESEND_API_KEY verification emails are skipped.
# MAIL_FROM must use the exact domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Telos <no-reply@team.telosstudio.games>
APP_BASE_URL=http://localhost:5000

# DATABASE CONFIGURATION (Knex)
# ============================================================================
# SQLite (Development - Default)
DB_CLIENT=sqlite3
DB_FILENAME=dev.sqlite3

# MySQL (Production Option 1)
# DB_CLIENT=mysql2
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_DATABASE=telos_db

# PostgreSQL (Production Option 2)
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_DATABASE=telos_db

# REDIS CONFIGURATION (Session & Permission Caching)
# ============================================================================
# Option 1: Full Redis URL (takes precedence)
# REDIS_URL=redis://:password@localhost:6379/0

# Option 2: Separate configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # Leave empty if no password

# ============================================================================
# NOTES FOR PRODUCTION
# ============================================================================
# 1. Set NODE_ENV=production for production deployments
# 2. Use strong SESSION_SECRET (minimum 32 characters, random)
# 3. Enable Redis in production for session persistence
# 4. Use MySQL/PostgreSQL instead of SQLite for production
# 5. Set DB credentials securely (use environment variables in deployment)
# 6. Use managed Redis service (AWS ElastiCache, Redis Cloud, etc.)
# 7. Enable HTTPS and set secure cookie flags
# ============================================================================
